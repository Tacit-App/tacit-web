{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/old",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/es",
      "destination": "/index.html"
    },
    {
      "source": "/es/",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/es/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/investors",
      "destination": "/investors/index.html"
    },
    {
      "source": "/investors/",
      "destination": "/investors/index.html"
    }
  ]
}

{
  "name": "tacit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "docs:dev": "npm run dev --workspace docs",
    "build": "npm run build --workspace site && npm run build --workspace docs && node scripts/merge-docs.mjs",
    "preview": "npm run preview --workspace site",
    "lint": "oxlint apps/site/src"
  },
  "devDependencies": {
    "oxlint": "^1.75.0"
  },
  "engines": {
    "node": ">=22"
  }
}
